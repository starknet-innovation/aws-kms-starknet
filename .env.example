# Supply credentials through your existing AWS SDK credential chain.
# AWS_PROFILE=your-existing-profile
AWS_REGION=eu-west-1
# Existing asymmetric key: ECC_SECG_P256K1, SIGN_VERIFY.
AWS_KMS_KEY_ID=

# Your authenticated mainnet RPC endpoint, supporting Starknet.js 10.8.0.
STARKNET_RPC_URL=
# Must match the compiled account artifact AND be declared on mainnet.
STARKNET_ACCOUNT_CLASS_HASH=0x000be1cf8839442d664572712fd36554c4d259f86549ad02e22353d10729b900
# Choose once; keep it stable to preserve the counterfactual deployment address.
STARKNET_ACCOUNT_SALT=0x1
# Optional: defaults to the address derived from class, salt, and KMS public key.
STARKNET_ACCOUNT_ADDRESS=
# Optional: override when using an artifact built elsewhere.
# STARKNET_ACCOUNT_ARTIFACT=contracts/preset/target/release/kms_oz_preset_EthAccountUpgradeable.contract_class.json
