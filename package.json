{
  "name": "starknet-aws-kms",
  "version": "0.1.0",
  "description": "Forkable Starknet mainnet examples with transaction signing inside AWS KMS.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cli": "node --env-file-if-exists=.env --import tsx examples/cli.ts",
    "contracts:build": "cd contracts && scarb build",
    "contracts:test": "cd contracts && snforge test",
    "verify": "npm run contracts:build && npm run preset:build && npm run build && npm test && npm run contracts:test && npm run preset:test",
    "test:kms": "npm run preset:build && node --env-file-if-exists=.env --import tsx tests/live-kms.ts",
    "preset:build": "scarb --manifest-path contracts/preset/Scarb.toml --release build",
    "preset:test": "cd contracts/preset && snforge test --release",
    "aws:setup": "node --import tsx scripts/setup-aws.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-kms": "3.1131.0",
    "@noble/curves": "1.9.7",
    "starknet": "10.8.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "private": true,
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  }
}
